.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.env
**/.env.*
.DS_Store
**/.DS_Store
*.egg-info/
**/*.egg-info/
Stage 1/output/
*.db
**/*.db
.git/
# The sample inventory is tracked in the public repo (already public), so it
# ships in the image as a seed; the entrypoint copies it to /data/inventory.yaml
# only when no inventory exists there. A private inventory mounted or copied to
# /data always wins and never enters the image.
# Terraform state/providers must never enter the build context: tfstate can
# hold sensitive values, and .terraform/ alone is ~750MB of providers.
Stage 5/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
