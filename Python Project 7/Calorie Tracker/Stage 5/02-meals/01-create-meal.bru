meta {
  name: Create Meal
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/meals/
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
}

script:pre-request {
  // eaten_at must be aware (UTC offset) and in the past — computed fresh
  // each run so the collection never goes stale.
  bru.setVar("eatenAt", new Date(Date.now() - 60 * 60 * 1000).toISOString());
}

body:json {
  {
    "name": "Bruno pho",
    "meal_type": "lunch",
    "calories": 540,
    "eaten_at": "{{eatenAt}}",
    "notes": "created by the Bruno collection"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.calories: eq 540
}

script:post-response {
  bru.setVar("mealId", res.body.id);
}

tests {
  test("response has no user field (ownership is server-side)", function () {
    expect(res.getBody()).to.not.have.property("user");
  });
}
