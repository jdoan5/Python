meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/token/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

script:post-response {
  bru.setVar("token", res.body.token);
}
